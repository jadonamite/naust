# HackCanton shared DevNet node (NODERS). Copy to .env and fill in. Never commit .env.
KEYCLOAK_TOKEN_URL=https://keycloak.naas.noders.services/realms/noders-appsfactory/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=web-app-ui-hackcanton-01-devnet
HACKCANTON_USERNAME=
HACKCANTON_PASSWORD=
JSON_API=https://ledger-api-json.participant.hackcanton-01.devnet.naas.noders.services
GRPC_API=ledger-api-grpc.participant.hackcanton-01.devnet.naas.noders.services:443
VALIDATOR_API=https://validator-api-http.validator.hackcanton-01.devnet.naas.noders.services

# Postgres connection string. Locally e.g. postgres://localhost:5432/naust_dev; on Vercel the Neon integration sets it.
DATABASE_URL=

# Guards GET /api/tick (Vercel Cron and the GitHub Actions schedule send it).
CRON_SECRET=
